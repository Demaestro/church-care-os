NODE_ENV=production
HOSTNAME=0.0.0.0
PORT=3000
AUTH_SECRET=replace-with-a-long-random-secret
APP_BASE_URL=
CARE_DB_PATH=
CARE_DATABASE_DRIVER=sqlite
CARE_UPLOADS_PATH=
CARE_ATTACHMENT_BACKEND=local
BACKUP_DIR=
BACKUP_MAX_AGE_HOURS=26
HEALTHCHECK_URL=
DATABASE_URL=
PGSSLMODE=
PGPOOL_MAX=20
PGPOOL_MIN=2
PGPOOL_IDLE_TIMEOUT_MS=30000
PGPOOL_CONNECTION_TIMEOUT_MS=5000
BLOB_READ_WRITE_TOKEN=
RESEND_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
CRON_SECRET=
HEALTHCHECK_TOKEN=
BOOTSTRAP_OWNER_NAME=Church Owner
BOOTSTRAP_OWNER_EMAIL=
BOOTSTRAP_OWNER_PASSWORD=
BOOTSTRAP_OWNER_ROLE=owner
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=
# ── AI (Claude by Anthropic) ──────────────────────────────────────────────────
# Get your key at https://console.anthropic.com → API Keys → Create Key
# Without this, the AI Shepherd sidebar will show a setup prompt instead of crashing.
ANTHROPIC_API_KEY=
# ── Security ─────────────────────────────────────────────────────────────────
# 32+ random hex characters for encrypting sensitive member fields at rest.
# Generate with: openssl rand -hex 32
CARE_ENCRYPTION_KEY=
# Set to "true" in production to enforce Secure + SameSite=Strict on session cookies.
CARE_SECURE_COOKIES=true
# ── Development / Seeding ────────────────────────────────────────────────────
# Set to "true" to auto-seed demo users on first startup (development only).
CARE_SEED_DEMO_USERS=false
